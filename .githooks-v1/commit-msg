#!/usr/bin/env bash
# Bearings v1 commit-msg hook shim.
#
# Mirrors .githooks-v1/pre-commit but for the commit-msg stage.
# See that file and scripts/setup-worktree.sh for the worktree-isolation
# rationale (core.hooksPath prevents `pre-commit install` from writing here,
# so this shim is hand-rolled).
#
# Anything more than this thin invocation belongs in
# `.pre-commit-config.yaml`, not here.
set -euo pipefail

readonly REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
readonly INSTALL_PYTHON="${REPO_ROOT}/.venv/bin/python"

if [[ ! -x "${INSTALL_PYTHON}" ]]; then
    echo "[commit-msg shim] No venv at ${INSTALL_PYTHON}." >&2
    echo "[commit-msg shim] Run 'uv sync --extra dev' from ${REPO_ROOT}." >&2
    exit 1
fi

cd "${REPO_ROOT}"
exec "${INSTALL_PYTHON}" -m pre_commit hook-impl \
    --config=.pre-commit-config.yaml \
    --hook-type=commit-msg \
    --hook-dir "$(dirname "$0")" \
    -- "$@"
